{
  "name": "mahjong-copilot",
  "private": true,
  "version": "1.1.0-beta.1",
  "capacitor": {
    "appId": "com.karislin.mahjong",
    "appName": "Mahjong Copilot",
    "webDir": "dist"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "capacitor:sync": "npx cap sync",
    "capacitor:add-android": "npx cap add android",
    "capacitor:open-android": "npx cap open android",
    "android:assembleDebug": "cd android && gradlew assembleDebug",
    "android:assembleRelease": "cd android && gradlew assembleRelease",
    "icons:generate": "node ./scripts/generate-android-icons.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.29",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
